# SQLite is the default. For the host CLI, set DATABASE_URL to the PostgreSQL
# container's published host port. URL-encode credentials in a complete URL.
DATABASE_URL=
BIOCYPHER_REGISTRY_DB_PATH=registry.sqlite3

# PostgreSQL Compose reads these credentials. Its backend sets POSTGRES_HOST
# to database; the host CLI can instead use localhost and the published port.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=biocypher
POSTGRES_DB=biocypher_registry
POSTGRES_PASSWORD=

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
AUTH_SESSION_SECRET=
FRONTEND_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# CLI access tokens are temporary and must never be added to this file.

# Additional self-hosted repository authorities can be explicitly approved.
REGISTRY_ALLOWED_REPOSITORY_HOSTS=github.com,gitlab.com
