# ===========================================================
# Database Selection for Host Commands
# ===========================================================
# Allowed values: sqlite, postgresql.
DATABASE_BACKEND=sqlite

# ===========================================================
# SQLite Configuration
# ===========================================================
SQLITE_DATABASE_PATH=registry.sqlite3

# ===========================================================
# PostgreSQL Configuration
# ===========================================================
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=biocypher
POSTGRES_DB=biocypher_registry
POSTGRES_PASSWORD=

# ===========================================================
# GitHub Authentication
# ===========================================================
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
AUTH_SESSION_SECRET=

# ===========================================================
# Browser-facing origins and private proxy target
# ===========================================================
# ---- Public site origin used for redirects and CORS.
FRONTEND_BASE_URL=http://localhost:5173
# ---- Browser-reachable API origin; FastAPI also uses it for the OAuth callback.
VITE_API_BASE_URL=http://localhost:8000
# ---- Private Docker-network address used by Nginx, never by browser code.
BACKEND_INTERNAL_URL=http://backend:8000

# ===========================================================
# Optional Repository Policy
# ===========================================================
REGISTRY_ALLOWED_REPOSITORY_HOSTS=github.com,gitlab.com

# ===========================================================
# PostgreSQL Test Configuration
# ===========================================================
REGISTRY_TEST_POSTGRES_CONTAINER=biocypher-registry-test-database

# ===========================================================
# Optional Agentic Workspace Configuration
# ===========================================================
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=
BIOCYPHER_MCP_URL=
BIOCYPHER_MCP_AUTH_HEADER=

# ===========================================================
# Optional LiteLLM Configuration
# ===========================================================
OPENAI_API_KEY=
LITELLM_MASTER_KEY=
